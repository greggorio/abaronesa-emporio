{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greggorio/abaronesa-emporio/ops/deploy/schemas/installed-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "environment",
    "release",
    "sourceCommit",
    "manifestSha256",
    "plannedAt",
    "installedAt",
    "reconciled",
    "components",
    "databases"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "installed-state"},
    "environment": {"const": "production"},
    "release": {"$ref": "#/$defs/semver"},
    "sourceCommit": {"$ref": "#/$defs/commitSha"},
    "manifestSha256": {"$ref": "#/$defs/digest"},
    "plannedAt": {"$ref": "#/$defs/utcSecond"},
    "installedAt": {
      "oneOf": [
        {"$ref": "#/$defs/utcSecond"},
        {"type": "null"}
      ]
    },
    "reconciled": {"type": "boolean"},
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/backend"},
        {"$ref": "#/$defs/websiteBack"},
        {"$ref": "#/$defs/frontend"},
        {"$ref": "#/$defs/websiteFront"},
        {"$ref": "#/$defs/whatsapp"},
        {"$ref": "#/$defs/gateway"}
      ],
      "items": false
    },
    "databases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/erpDatabase"},
        {"$ref": "#/$defs/websiteDatabase"}
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"reconciled": {"const": true}},
        "required": ["reconciled"]
      },
      "then": {
        "properties": {"installedAt": {"$ref": "#/$defs/utcSecond"}}
      },
      "else": {
        "properties": {"installedAt": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcSecond": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:[._][0-9]+)*$"
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "immutableRef"],
      "properties": {
        "id": {"type": "string"},
        "immutableRef": {"type": "string"}
      }
    },
    "backend": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "backend"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-backend@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "websiteBack": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "website_back"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-website-backend@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "frontend": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "frontend"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-frontend@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "websiteFront": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "website_front"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-website-frontend@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "whatsapp": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "whatsapp_service"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-whatsapp-service@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "gateway": {
      "allOf": [
        {"$ref": "#/$defs/component"},
        {
          "properties": {
            "id": {"const": "gateway"},
            "immutableRef": {
              "pattern": "^ghcr\\.io/greggorio/abaronesa-emporio-gateway@sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerComponent",
        "migrationSetSha256",
        "migrations"
      ],
      "properties": {
        "id": {"type": "string"},
        "ownerComponent": {"type": "string"},
        "migrationSetSha256": {"$ref": "#/$defs/digest"},
        "migrations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/migration"}
        }
      }
    },
    "erpDatabase": {
      "allOf": [
        {"$ref": "#/$defs/database"},
        {
          "properties": {
            "id": {"const": "erp"},
            "ownerComponent": {"const": "backend"}
          }
        }
      ]
    },
    "websiteDatabase": {
      "allOf": [
        {"$ref": "#/$defs/database"},
        {
          "properties": {
            "id": {"const": "website"},
            "ownerComponent": {"const": "website_back"}
          }
        }
      ]
    }
  }
}
