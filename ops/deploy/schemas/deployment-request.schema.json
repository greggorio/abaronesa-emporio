{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abaronesa.invalid/schemas/deployment-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "controlSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "kind": {
      "const": "deployment-request"
    },
    "operationId": {
      "pattern": "^[A-Za-z0-9_-]{20,128}$",
      "type": "string"
    },
    "plannedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "repository": {
      "const": "greggorio/abaronesa-emporio"
    },
    "requestedActorId": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1
    },
    "targetRelease": {
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "workflowRunAttempt": {
      "minimum": 1,
      "type": "integer"
    },
    "workflowRunId": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "operationId",
    "targetRelease",
    "controlSha",
    "workflowRunId",
    "workflowRunAttempt",
    "requestedActorId",
    "plannedAt"
  ],
  "title": "Deployment request",
  "type": "object"
}
