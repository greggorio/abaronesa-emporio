{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abaronesa.invalid/schemas/production-snapshot.schema.json",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release": {
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capturedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "currentManifestSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentRelease": {
      "oneOf": [
        {
          "$ref": "#/$defs/release"
        },
        {
          "type": "null"
        }
      ]
    },
    "installedStateSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "const": "production-snapshot"
    },
    "mode": {
      "enum": [
        "FIRST_INSTALL",
        "UPDATE"
      ]
    },
    "operationId": {
      "pattern": "^[A-Za-z0-9_-]{20,128}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "targetRelease": {
      "$ref": "#/$defs/release"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "operationId",
    "targetRelease",
    "mode",
    "capturedAt",
    "currentRelease",
    "installedStateSha256",
    "currentManifestSha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "FIRST_INSTALL"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "currentManifestSha256": {
            "type": "null"
          },
          "currentRelease": {
            "type": "null"
          },
          "installedStateSha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "currentManifestSha256": {
            "$ref": "#/$defs/digest"
          },
          "currentRelease": {
            "$ref": "#/$defs/release"
          },
          "installedStateSha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  ],
  "title": "Production snapshot",
  "type": "object"
}
