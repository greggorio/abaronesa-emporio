{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greggorio/abaronesa-emporio/ops/deploy/schemas/backup-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "operationId",
    "sourceRelease",
    "targetRelease",
    "createdAt",
    "databases",
    "complete"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "deployment-backup"},
    "operationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{20,128}$"},
    "sourceRelease": {
      "oneOf": [
        {"$ref": "#/$defs/release"},
        {"type": "null"}
      ]
    },
    "targetRelease": {"$ref": "#/$defs/release"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "databases": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [{"$ref": "#/$defs/erp"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        {
          "type": "array",
          "prefixItems": [{"$ref": "#/$defs/website"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/erp"},
            {"$ref": "#/$defs/website"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "complete": {"const": true}
  },
  "$defs": {
    "release": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sha256", "size"],
      "properties": {
        "id": {"enum": ["erp", "website"]},
        "file": {"enum": ["erp.dump", "website.dump"]},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "erp": {
      "allOf": [
        {"$ref": "#/$defs/database"},
        {
          "properties": {
            "id": {"const": "erp"},
            "file": {"const": "erp.dump"}
          }
        }
      ]
    },
    "website": {
      "allOf": [
        {"$ref": "#/$defs/database"},
        {
          "properties": {
            "id": {"const": "website"},
            "file": {"const": "website.dump"}
          }
        }
      ]
    }
  }
}
