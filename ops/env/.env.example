# Imagens imutaveis
POSTGRES_IMAGE=postgres:16.10-alpine3.22@sha256:<64-hex>
BACKEND_IMAGE=ghcr.io/greggorio/abaronesa-emporio-backend@sha256:<64-hex>
WEBSITE_BACK_IMAGE=ghcr.io/greggorio/abaronesa-emporio-website-backend@sha256:<64-hex>
FRONTEND_IMAGE=ghcr.io/greggorio/abaronesa-emporio-frontend@sha256:<64-hex>
WEBSITE_FRONT_IMAGE=ghcr.io/greggorio/abaronesa-emporio-website-frontend@sha256:<64-hex>
WHATSAPP_IMAGE=ghcr.io/greggorio/abaronesa-emporio-whatsapp-service@sha256:<64-hex>
GATEWAY_IMAGE=ghcr.io/greggorio/abaronesa-emporio-gateway@sha256:<64-hex>

# Topologia; omita overrides para usar nomes canonicos
GATEWAY_LOOPBACK_PORT=8120
APP_NETWORK_NAME=
DB_NETWORK_NAME=
POSTGRES_VOLUME_NAME=
BACKEND_UPLOADS_VOLUME_NAME=
WEBSITE_UPLOADS_VOLUME_NAME=
WHATSAPP_SESSION_VOLUME_NAME=

# Recursos efetivos por servico
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=1.0
POSTGRES_PIDS_LIMIT=256
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.5
BACKEND_PIDS_LIMIT=256
WEBSITE_BACK_MEM_LIMIT=1g
WEBSITE_BACK_CPUS=1.5
WEBSITE_BACK_PIDS_LIMIT=256
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5
FRONTEND_PIDS_LIMIT=128
WEBSITE_FRONT_MEM_LIMIT=256m
WEBSITE_FRONT_CPUS=0.5
WEBSITE_FRONT_PIDS_LIMIT=128
WHATSAPP_MEM_LIMIT=768m
WHATSAPP_CPUS=1.0
WHATSAPP_PIDS_LIMIT=256
GATEWAY_MEM_LIMIT=128m
GATEWAY_CPUS=0.5
GATEWAY_PIDS_LIMIT=128

# PostgreSQL: nomes/usuarios devem ser distintos
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
WEBSITE_DB_NAME=
WEBSITE_DB_USER=
WEBSITE_DB_PASSWORD=

# Segredos compartilhados e sincronizacao
INTEGRATION_SYSTEM_TOKEN_SECRET=
# Origem unica dos aliases ESPRESSO_SYNC_API_KEY e WEBSITE_SYNC_API_KEY no
# backend ERP, e WEBSITE_ERP_SYNC_KEY no website backend.
ERP_WEBSITE_SYNC_KEY=
WEBSITE_INTERNAL_SYNC_URL=http://website_back:8085
ROOT_BOOTSTRAP_ENABLED=false
ROOT_BOOTSTRAP_NAME=
ROOT_BOOTSTRAP_EMAIL=
ROOT_BOOTSTRAP_PASSWORD=

# Ponte RS256/JWKS do deployer. A chave permanece fora do repositorio e e
# montada somente no backend no path fixo /run/secrets/.
RELEASE_CONTROL_DEPLOYER_IDENTITY_ENABLED=false
RELEASE_CONTROL_DEPLOYER_IDENTITY_ISSUER=https://erp-emporio.abaronesa.net.br
RELEASE_CONTROL_DEPLOYER_IDENTITY_PRIVATE_KEY_FILE=
RELEASE_CONTROL_DEPLOYER_IDENTITY_KEY_ID=
RELEASE_CONTROL_MODE=disabled

# URLs publicas, OAuth e allowlists
ERP_PUBLIC_URL=https://erp-emporio.abaronesa.net.br
WEBSITE_PUBLIC_URL=https://emporio.abaronesa.net.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp-emporio.abaronesa.net.br/login/oauth2/code/google
ERP_CORS_ALLOWED_ORIGINS=https://erp-emporio.abaronesa.net.br,https://emporio.abaronesa.net.br
WEBSITE_CORS_ALLOWED_ORIGINS=https://emporio.abaronesa.net.br,https://erp-emporio.abaronesa.net.br
WEBSITE_WEBSOCKET_ALLOWED_ORIGINS=https://emporio.abaronesa.net.br,https://erp-emporio.abaronesa.net.br

# Java
BACKEND_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
WEBSITE_BACK_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# SMTP opcional
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Uber opcional, consumido pelos dois backends
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_ACCESS_TOKEN=
UBER_SCOPE=
UBER_PICKUP_NAME=
UBER_PICKUP_PHONE=
UBER_PICKUP_ADDRESS=
UBER_PICKUP_NOTES=
UBER_PICKUP_READY_PATH=

# Firebase opcional; provisionar arquivo no volume antes de habilitar
APP_FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/app/uploads/android-private/firebase-adminsdk.json

# WhatsApp
BASE_COUNTRY_CODE=55

# Runtime publico dos frontends e paths internos sao derivados das URLs acima:
# frontend: VITE_BASE_API_URL <- ERP_PUBLIC_URL; RELEASE_CONTROL_MODE <- disabled|deployer
# website_front: VITE_ERP_API_URL <- ERP_PUBLIC_URL
# website_front: VITE_WEBSITE_API_URL <- WEBSITE_PUBLIC_URL
# backend: WHATSAPP_SERVICE_URL=http://whatsapp_service:3001
# NFE_SCHEMA_PATH=/app/nfe/schemas; NFE_XML_PATH=/app/uploads/nfe/xmls
# uploads backend/website sao montados em /app/uploads.
