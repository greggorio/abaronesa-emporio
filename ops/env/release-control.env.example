# Copy to a protected runtime environment file outside the repository.
# Every value below is a placeholder; do not commit credentials or key material.
RELEASE_CONTROL_PROFILE=runtime
RELEASE_CONTROL_MODE=deployer
RELEASE_CONTROL_IMAGE=emporio-release-control@sha256:<immutable-image-digest>
RELEASE_CONTROL_POSTGRES_IMAGE=postgres:16.6-alpine
RELEASE_CONTROL_LOOPBACK_PORT=8180

RELEASE_CONTROL_DB_HOST=release_control_postgresql
RELEASE_CONTROL_DB_PORT=5432
RELEASE_CONTROL_DB_NAME=emporio_release_control
RELEASE_CONTROL_DB_USER=<database-user>
RELEASE_CONTROL_DB_PASSWORD=<database-password-from-secret-manager>
RELEASE_CONTROL_DB_SSLMODE=require

RELEASE_CONTROL_JWT_ISSUER=https://<control-plane-host>/api/release-control/identity/deployer
RELEASE_CONTROL_JWT_AUDIENCE=emporio-release-control-deployer
RELEASE_CONTROL_JWT_JWKS_URL=https://<control-plane-host>/api/release-control/identity/deployer/jwks
RELEASE_CONTROL_CORS_ORIGINS=https://<authorized-ui-origin>

RELEASE_CONTROL_GITHUB_APP_ID=<github-app-id>
RELEASE_CONTROL_GITHUB_INSTALLATION_ID=<github-installation-id>
RELEASE_CONTROL_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key
RELEASE_CONTROL_HASH_PEPPER=<at-least-32-random-bytes-from-secret-manager>
RELEASE_CONTROL_GITHUB_API_BASE=https://api.github.com

RELEASE_CONTROL_RECONCILE_INTERVAL_SECONDS=15
RELEASE_CONTROL_DISPATCH_DISCOVERY_TIMEOUT_SECONDS=600
RELEASE_CONTROL_HTTP_CONNECT_TIMEOUT_SECONDS=3
RELEASE_CONTROL_HTTP_READ_TIMEOUT_SECONDS=10
RELEASE_CONTROL_GITHUB_MAX_PAGES=10
RELEASE_CONTROL_IDEMPOTENCY_RETENTION_DAYS=365
RELEASE_CONTROL_READ_RATE_PER_MINUTE=120
RELEASE_CONTROL_PUBLISH_RATE_PER_MINUTE=5
RELEASE_CONTROL_DEPLOY_RATE_PER_MINUTE=5
RELEASE_CONTROL_ROLLBACK_RATE_PER_MINUTE=2
RELEASE_CONTROL_MAX_JSON_BODY_BYTES=16384
