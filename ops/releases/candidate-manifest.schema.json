{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greggorio/abaronesa-emporio/ops/releases/candidate-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","kind","deployable","candidateId","repository","commitSha","ref","createdAt","workflow","sourceCi","catalog","predecessor","resolution","components","integration"],
  "properties": {
    "schemaVersion":{"const":2},"kind":{"const":"ci-candidate"},"deployable":{"type":"boolean"},
    "candidateId":{"type":"string","pattern":"^candidate-[a-z0-9._-]+$"},"repository":{"const":"greggorio/abaronesa-emporio"},
    "commitSha":{"$ref":"#/$defs/sha"},"ref":{"const":"refs/heads/main"},"createdAt":{"$ref":"#/$defs/time"},
    "workflow":{"$ref":"#/$defs/workflow"},"sourceCi":{"$ref":"#/$defs/sourceCi"},"catalog":{"$ref":"#/$defs/catalog"},
    "predecessor":{"$ref":"#/$defs/predecessor"},"resolution":{"$ref":"#/$defs/resolution"},"components":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/component"}},
    "integration":{"$ref":"#/$defs/integration"}
  },
  "$defs": {
    "sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"rawDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"time":{"type":"string","format":"date-time","pattern":"Z$"},
    "ids":{"type":"array","uniqueItems":true,"items":{"enum":["backend","website_back","frontend","website_front","whatsapp_service","gateway"]}},
    "workflow":{"type":"object","additionalProperties":false,"required":["runId","attempt","url"],"properties":{"runId":{"type":"string","pattern":"^[1-9][0-9]*$"},"attempt":{"type":"integer","minimum":1},"url":{"type":"string","pattern":"^https://github\\.com/greggorio/abaronesa-emporio/actions/runs/[1-9][0-9]*$"}}},
    "sourceCi":{"type":"object","additionalProperties":false,"required":["runId","attempt","baseCommitSha","planSha256"],"properties":{"runId":{"type":"string","pattern":"^[1-9][0-9]*$"},"attempt":{"type":"integer","minimum":1},"baseCommitSha":{"$ref":"#/$defs/sha"},"planSha256":{"$ref":"#/$defs/digest"}}},
    "catalog":{"type":"object","additionalProperties":false,"required":["schemaVersion","sha256"],"properties":{"schemaVersion":{"const":1},"sha256":{"$ref":"#/$defs/digest"}}},
    "predecessor":{"type":"object","additionalProperties":false,"required":["status","candidateId","commitSha","workflowRunId","artifactId","artifactDigest"],"properties":{"status":{"enum":["first","selected"]},"candidateId":{"type":["string","null"]},"commitSha":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"workflowRunId":{"type":["string","null"],"pattern":"^[1-9][0-9]*$"},"artifactId":{"type":["string","null"],"pattern":"^[1-9][0-9]*$"},"artifactDigest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"status":{"const":"first"}}},"then":{"properties":{"candidateId":{"type":"null"},"commitSha":{"type":"null"},"workflowRunId":{"type":"null"},"artifactId":{"type":"null"},"artifactDigest":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"selected"}}},"then":{"properties":{"candidateId":{"type":"string","minLength":1},"commitSha":{"$ref":"#/$defs/sha"},"workflowRunId":{"type":"string","pattern":"^[1-9][0-9]*$"},"artifactId":{"type":"string","pattern":"^[1-9][0-9]*$"},"artifactDigest":{"$ref":"#/$defs/digest"}}}}]},
    "resolution":{"type":"object","additionalProperties":false,"required":["classification","changedPaths","directComponents","buildComponents","validationComponents","inheritedComponents","warnings"],"properties":{"classification":{"enum":["first_release","unknown","global","mixed_global","components","mixed","documentation"]},"changedPaths":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"directComponents":{"$ref":"#/$defs/ids"},"buildComponents":{"$ref":"#/$defs/ids"},"validationComponents":{"$ref":"#/$defs/ids"},"inheritedComponents":{"$ref":"#/$defs/ids"},"warnings":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "checks":{"type":"object","additionalProperties":false,"required":["build","test","scan"],"properties":{"build":{"const":"passed"},"test":{"const":"passed"},"scan":{"const":"passed"}}},
    "labels":{"type":"object","additionalProperties":false,"required":["org.opencontainers.image.source","org.opencontainers.image.revision","org.opencontainers.image.version","org.opencontainers.image.created"],"properties":{"org.opencontainers.image.source":{"const":"https://github.com/greggorio/abaronesa-emporio"},"org.opencontainers.image.revision":{"$ref":"#/$defs/sha"},"org.opencontainers.image.version":{"type":"string"},"org.opencontainers.image.created":{"$ref":"#/$defs/time"}}},
    "component":{"type":"object","additionalProperties":false,"required":["id","imageRepository","tag","digest","immutableRef","commitSha","workflowRunId","workflowAttempt","builtAt","state","originCandidateId","labels","checks"],"properties":{"id":{"enum":["backend","website_back","frontend","website_front","whatsapp_service","gateway"]},"imageRepository":{"type":"string","pattern":"^ghcr\\.io/greggorio/abaronesa-emporio-[a-z0-9-]+$"},"tag":{"type":"string","pattern":"^ghcr\\.io/greggorio/abaronesa-emporio-[a-z0-9-]+:sha-[0-9a-f]{40}$"},"digest":{"$ref":"#/$defs/digest"},"immutableRef":{"type":"string","pattern":"^ghcr\\.io/greggorio/abaronesa-emporio-[a-z0-9-]+@sha256:[0-9a-f]{64}$"},"commitSha":{"$ref":"#/$defs/sha"},"workflowRunId":{"type":"string","pattern":"^[1-9][0-9]*$"},"workflowAttempt":{"type":"integer","minimum":1},"builtAt":{"$ref":"#/$defs/time"},"state":{"enum":["built","inherited"]},"originCandidateId":{"type":["string","null"]},"labels":{"$ref":"#/$defs/labels"},"checks":{"$ref":"#/$defs/checks"}}},
    "service":{"type":"object","additionalProperties":false,"required":["id","state","health"],"properties":{"id":{"enum":["postgresql","backend","website_back","frontend","website_front","whatsapp_service","gateway"]},"state":{"const":"running"},"health":{"const":"healthy"}}},
    "probe":{"type":"object","additionalProperties":false,"required":["id","status"],"properties":{"id":{"enum":["website_root","erp_root","website_theme_api","erp_login","erp_whatsapp_api","publisher_route_absent","deployer_route_absent","unknown_host_denied","whatsapp_internal"]},"status":{"const":"passed"}}},
    "cleanup":{"type":"object","additionalProperties":false,"required":["containers","volumes","networks","imagesAbsent"],"properties":{"containers":{"const":0},"volumes":{"const":0},"networks":{"const":0},"imagesAbsent":{"type":"integer","const":6}}},
    "integration":{"type":"object","additionalProperties":false,"required":["workflowRunId","workflowAttempt","pendingSha256","receiptSha256","checkedAt","status","services","probes","cleanup"],"properties":{"workflowRunId":{"type":"string","pattern":"^[1-9][0-9]*$"},"workflowAttempt":{"type":"integer","minimum":1},"pendingSha256":{"$ref":"#/$defs/digest"},"receiptSha256":{"$ref":"#/$defs/digest"},"checkedAt":{"$ref":"#/$defs/time"},"status":{"const":"passed"},"services":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/service"}},"probes":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/probe"}},"cleanup":{"$ref":"#/$defs/cleanup"}}}
  }
}
