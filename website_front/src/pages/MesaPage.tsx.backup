import { useEffect, useMemo, useRef, useState } from 'react';
import { useParams, Link, useNavigate } from 'react-router-dom';
import { useAuth } from '@/hooks/useAuth';
import { useToast } from '@/hooks/use-toast';
import { useNotifications } from '@/hooks/useNotifications';
import { NotificationBadge } from '@/components/NotificationBadge';
import { apiConfig } from '@/config/api';
import axios from '@/lib/axios';
import { Sheet, SheetContent, SheetHeader, SheetTitle } from '@/components/ui/sheet';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { ChevronLeft, ChevronRight, ChevronDown, Home, Star, Share2, User, FileText, Pencil } from 'lucide-react';
import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
import { getPairingsFor } from '@/data/recommendations';

type GuestSession = {
  sessaoConvidadoId: number;
  sessaoMesaId: number;
  guestToken: string;
  nomeExibicao: string;
  host?: boolean;
};

type CardapioCategoria = {
  id: number;
  nome: string;
  produtos: {
    id: number;
    nome: string;
    preco?: number;
    precoVenda?: number;
    imagemPrincipal?: string;
    skus?: { id: number; variacao?: string; preco?: number; precoVenda?: number }[];
  }[];
};

type ContaConvidado = {
  sessaoConvidadoId: number;
  nome: string;
  subtotalCentavos: number;
  ajustesCentavos: number;
  pagoCentavos: number;
  devidoCentavos: number;
  itens?: { pedidoId: number; pedidoStatus: string; pedidoCriadoEm: string; itemPedidoId: number; produtoId: number; produtoNome: string; quantidade: number; precoUnitCentavos: number; status: string; observacoes?: string | null }[];
};

// Editor de observações com Popover (reutilizável no carrinho)
function ObservationEditor({ value, onChange, maxLength = 200 }: { value: string; onChange: (v: string) => void; maxLength?: number }) {
  const [open, setOpen] = useState(false);
  const [temp, setTemp] = useState(value || '');

  useEffect(() => {
    if (open) setTemp(value || '');
  }, [open, value]);

  const hasText = (value || '').trim().length > 0;

  return (
    <Popover open={open} onOpenChange={setOpen}>
      <PopoverTrigger asChild>
        <button
          type="button"
          className={`border ${hasText ? 'border-coral-accent' : 'border-coral-accent/30'} px-2 py-1 rounded text-xs hover:bg-coral-accent/10 flex items-center gap-1`}
          title={hasText ? 'Editar observações' : 'Adicionar observações'}
        >
          <span className="relative inline-block w-4 h-4">
            <FileText className="absolute w-4 h-4 text-cream/80" />
            <Pencil className="absolute w-3 h-3 text-coral-accent" style={{ top: -2, right: -2 }} />
          </span>
          <span>Obs</span>
        </button>
      </PopoverTrigger>
      <PopoverContent side="top" align="end" className="w-72 bg-forest-dark text-cream border border-coral-accent/20">
        <div className="space-y-2">
          <div className="text-xs text-cream/70">Observações (opcional)</div>
          <textarea
            className="w-full border border-coral-accent/30 bg-transparent rounded px-2 py-1.5 text-xs placeholder:text-cream/40 resize-none"
            rows={3}
            maxLength={maxLength}
            placeholder="Ex: sem cebola, ponto mal passado"
            value={temp}
            onChange={(e) => setTemp(e.target.value)}
          />
          <div className="flex items-center justify-between">
            <div className="text-[11px] text-cream/60">{temp.length}/{maxLength}</div>
            <div className="flex items-center gap-2">
              <button
                type="button"
                className="text-[11px] px-2 py-1 rounded border border-coral-accent/30 hover:bg-coral-accent/10"
                onClick={() => setTemp('')}
              >
                Limpar
              </button>
              <button
                type="button"
                className="text-[11px] px-2 py-1 rounded bg-coral-accent text-forest-dark hover:bg-coral-accent/90"
                onClick={() => { onChange(temp); setOpen(false); }}
              >
                Salvar
              </button>
            </div>
          </div>
        </div>
      </PopoverContent>
    </Popover>
  );
}

// Lista pedidos da mesa agrupados por pessoa e por pedido
function MesaPedidosList({ sessaoMesaId, pessoas }:{ sessaoMesaId: number; pessoas: { sessaoConvidadoId: number; nome?: string; name?: string }[] }){
  const [itemsByGuest, setItemsByGuest] = useState<Record<number, any[]>>({});

  // Helpers locais (cópia das funções de estilo/status)
  const badgeClassLocal = (status?: string) => {
    switch ((status || '').toLowerCase()) {
      case 'queued': return 'bg-gray-100 text-gray-700';
      case 'pending': return 'bg-gray-100 text-gray-700';
      case 'accepted': return 'bg-blue-100 text-blue-700';
      case 'preparing': return 'bg-amber-100 text-amber-700';
      case 'ready': return 'bg-emerald-100 text-emerald-700';
      case 'delivered': return 'bg-green-100 text-green-700';
      case 'canceled': return 'bg-red-100 text-red-700';
      default: return 'bg-gray-100 text-gray-700';
    }
  };

  const statusLabelLocal = (status?: string) => {
    switch ((status || '').toLowerCase()) {
      case 'queued': return 'Pendente';
      case 'pending': return 'Pendente';
      case 'accepted': return 'Aceito';
      case 'preparing': return 'Preparando';
      case 'ready': return 'Pronto';
      case 'delivered': return 'Entregue';
      case 'canceled': return 'Cancelado';
      default: return (status || '');
    }
  };

  useEffect(() => {
    let cancelled = false;
    (async () => {
      const entries: Record<number, any[]> = {};
      for (const p of pessoas || []) {
        try {
          const res = await fetch(`${apiConfig.erpBaseUrl}/api/conta?sessaoConvidadoId=${p.sessaoConvidadoId}`);
          if (res.ok) {
            const data = await res.json();
            entries[p.sessaoConvidadoId] = data?.itens || [];
          }
        } catch {}
      }
      if (!cancelled) setItemsByGuest(entries);
    })();
    return () => { cancelled = true; };
  }, [sessaoMesaId, JSON.stringify(pessoas)]);

  const guests = pessoas || [];
  if (guests.length === 0) return <div className="text-sm text-cream/70">Sem pedidos na mesa ainda.</div>;

  return (
    <div className="space-y-4">
      {guests.map((p) => {
        const items = itemsByGuest[p.sessaoConvidadoId] || [];
        if (!items.length) return null;
        const grouped: Record<string, any[]> = items.reduce((acc:any, it:any) => {
          const k = String(it.pedidoId);
          (acc[k] ||= []).push(it);
          return acc;
        }, {});
        return (
          <div key={p.sessaoConvidadoId} className="border border-coral-accent/20 rounded bg-coral-accent/5">
            <div className="px-3 py-2 text-sm font-medium">{p.nome || (p as any).name || `Convidado ${p.sessaoConvidadoId}`}</div>
            <div className="divide-y">
              {Object.entries(grouped).map(([pedidoId, itens]: any) => {
                const created = new Date(itens[0].pedidoCriadoEm).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
                const status = itens[0].pedidoStatus;
                return (
                  <div key={pedidoId}>
                    <div className="flex items-center justify-between px-3 py-2 bg-coral-accent/5">
                      <div className="text-xs">Pedido #{pedidoId} • {created}</div>
                      <div className={`text-xs px-2 py-0.5 rounded ${badgeClassLocal(status)}`}>{statusLabelLocal(status)}</div>
                    </div>
                    <div className="px-3 py-2 space-y-2">
                      {itens.map((it:any) => {
                        const isCanceled = it.status?.toLowerCase() === 'canceled';
                        return (
                          <div key={it.itemPedidoId} className={isCanceled ? 'opacity-60' : ''}>
                            <div className="flex justify-between text-sm">
                              <div className={`text-cream/90 ${isCanceled ? 'line-through' : ''}`}>{it.produtoNome} <span className="text-cream/70">x {it.quantidade}</span></div>
                              <div className={isCanceled ? 'line-through' : ''}>R$ {((it.precoUnitCentavos * it.quantidade)/100).toFixed(2)}</div>
                            </div>
                            {it.observacoes && (
                              <div className="text-xs text-cream/60 italic mt-0.5 flex items-center gap-1">
                                <span>📝</span>
                                <span>{it.observacoes}</span>
                              </div>
                            )}
                            {isCanceled && (
                              <div className="text-xs text-red-400 mt-0.5 flex items-center gap-1">
                                <span>❌</span>
                                <span>Cancelado</span>
                              </div>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
}

export default function MesaPage() {
  const { mesaSlug } = useParams();
  const navigate = useNavigate();
  const storageKey = useMemo(() => `qrGuest:${mesaSlug}`, [mesaSlug]);
  const [guest, setGuest] = useState<GuestSession | null>(null);
  const [nome, setNome] = useState('');
  const [loading, setLoading] = useState(false);
  const [autoJoinInProgress, setAutoJoinInProgress] = useState(false);
  const [showUserMenu, setShowUserMenu] = useState(false);
  const [showShareDialog, setShowShareDialog] = useState(false);
  const [tab, setTab] = useState<'menu' | 'pedidos' | 'conta'>('menu');
  const [selectedCategoryId, setSelectedCategoryId] = useState<number | 'all'>('all');
  const [search, setSearch] = useState('');
  const [cardapio, setCardapio] = useState<CardapioCategoria[]>([]);
  const [cart, setCart] = useState<{ produtoId: number; nome: string; preco: number; quantidade: number; observacoes?: string; skuId?: number }[]>([]);
  const [cartOpen, setCartOpen] = useState(false);
  const [conta, setConta] = useState<ContaConvidado | null>(null);
  const [contaMesa, setContaMesa] = useState<{ totalMesaCentavos: number; pagoCentavos: number; devidoCentavos: number; pessoas: { sessaoConvidadoId: number; name?: string; nome?: string; subtotalCentavos: number; pagoCentavos: number; devidoCentavos: number }[] } | null>(null);
  const [contaView, setContaView] = useState<'mine' | 'mesa'>('mine');
  const [pedidosView, setPedidosView] = useState<'mine' | 'mesa'>('mine');
  const [qrPayload, setQrPayload] = useState<string | null>(null);
  const [sessionClosed, setSessionClosed] = useState<boolean>(false);
  const [unreadNotifications, setUnreadNotifications] = useState<number>(0);
  const [sessaoAtiva, setSessaoAtiva] = useState<{ totalConvidados: number; mesaRotulo: string } | null>(null);
  const [showConfirmDialog, setShowConfirmDialog] = useState(false);
  const [detailsOpen, setDetailsOpen] = useState(false);
  const [detailProduct, setDetailProduct] = useState<any | null>(null);
  const handleGoogleLoginOnMesa = () => {
    try { document.cookie = "oauth_origin=villa; path=/; max-age=300"; } catch {}
    try { if (mesaSlug) localStorage.setItem('post_login_redirect', `/m/${mesaSlug}`); } catch {}
    window.location.href = `${apiConfig.erpBaseUrl}/api/auth/oauth2/google/ecommerce`;
  };
  const [selectedMedia, setSelectedMedia] = useState<{ type: 'video' | 'image', url: string } | null>(null);
  const { toast } = useToast();
  const { permission, requestPermission, showNotification } = useNotifications();
  const qrImageUrl = useMemo(() => (qrPayload ? `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(qrPayload)}` : null), [qrPayload]);

  // QR Code para compartilhar mesa
  const shareQrUrl = useMemo(() => {
    if (!mesaSlug) return null;
    const mesaUrl = `${window.location.origin}/m/${mesaSlug}`;
    return `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(mesaUrl)}`;
  }, [mesaSlug]);
  const sseRef = useRef<EventSource | null>(null);
  const guestIdRef = useRef<number | null>(null);
  const autoJoinStartedRef = useRef<boolean>(false);
  const { isAuthenticated, user } = useAuth();
  const cartSectionRef = useRef<HTMLDivElement | null>(null);
  const [cartSectionVisible, setCartSectionVisible] = useState(false);
  const catScrollRef = useRef<HTMLDivElement | null>(null);
  const [catCanScrollLeft, setCatCanScrollLeft] = useState(false);
  const [catCanScrollRight, setCatCanScrollRight] = useState(false);

  // Pairings (mock-based, resolved against current cardápio)
  const pairings = useMemo(() => {
    try {
      if (!detailProduct) return [] as any[];
      return getPairingsFor(detailProduct, cardapio as any, 6);
    } catch {
      return [] as any[];
    }
  }, [detailProduct, cardapio]);

  // Exibir no máximo 4 itens no mobile para preservar estética
  const pairingsLimited = useMemo(() => (pairings || []).slice(0, 2), [pairings]);

  // Fetch unread notifications count
  const fetchUnreadCount = async (guestToken: string) => {
    try {
      const response = await axios.get<{ count: number }>(
        `${apiConfig.erpBaseUrl}/api/notificacoes/contador`,
        {
          headers: { 'X-Guest-Token': guestToken },
        }
      );
      setUnreadNotifications(response.data.count);
    } catch (error) {
      console.error('Error fetching unread count:', error);
    }
  };

  useEffect(() => {
    // restore guest
    try {
      const raw = localStorage.getItem(storageKey);
      console.log('[MesaPage] localStorage guest:', raw ? 'encontrado' : 'não encontrado');
      if (raw) {
        const data = JSON.parse(raw) as GuestSession;
        setGuest(data);
        guestIdRef.current = data.sessaoConvidadoId;
        setNome(data.nomeExibicao || '');
        connectSSE(data.sessaoMesaId);
        refreshConta(data.sessaoConvidadoId);

        // If host, request notification permission and fetch unread notifications
        if (data.host) {
          requestPermission();
          fetchUnreadCount(data.guestToken);
        }
      } else {
        // Se não há guest salvo
        // Caso esteja autenticado como CLIENTE, faz auto ingresso na mesa usando o nome do login
        if (!autoJoinStartedRef.current && isAuthenticated && user?.roles?.includes('CLIENTE')) {
          autoJoinStartedRef.current = true;
          const displayName = (user?.nome || '').trim();
          console.log('[MesaPage] Auto-ingresso ativado para CLIENTE autenticado. Nome:', displayName || '(vazio)');
          if (displayName.length >= 2 && mesaSlug) {
            setAutoJoinInProgress(true);
            setNome(displayName);
            // Usa fluxo padrão de criação de convidado com nome do usuário autenticado
            startAsGuest(displayName).finally(() => {
              setAutoJoinInProgress(false);
            });
          } else {
            // Se não houver nome válido, cai no fluxo manual
            console.log('[MesaPage] Nome inválido para auto-ingresso. Mostrando formulário manual.');
            console.log('[MesaPage] Sem guest no localStorage, verificando sessão ativa');
            verificarSessaoAtiva();
          }
        } else {
          // Fluxo padrão (anônimo ou não-CLIENTE)
          console.log('[MesaPage] Sem guest no localStorage, verificando sessão ativa');
          verificarSessaoAtiva();
        }
      }
    } catch {}
  }, [storageKey, isAuthenticated, user, mesaSlug]);

  const verificarSessaoAtiva = async () => {
    if (!mesaSlug) return;
    console.log('[MesaPage] Verificando sessão ativa para mesa:', mesaSlug);
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/mesas/${mesaSlug}/sessao`, { cache: 'no-store' });
      if (res.ok) {
        const data = await res.json();
        console.log('[MesaPage] Resposta da verificação:', data);
        if (data.sessaoAtiva && data.totalConvidados > 0) {
          console.log('[MesaPage] Sessão ativa detectada, mostrando dialog');
          setSessaoAtiva({
            totalConvidados: data.totalConvidados,
            mesaRotulo: data.mesaRotulo
          });
          setShowConfirmDialog(true);
        } else {
          console.log('[MesaPage] Nenhuma sessão ativa ou sem convidados');
        }
      } else {
        const msg = await res.text();
        console.warn('[MesaPage] Falha ao verificar sessão:', res.status, msg);
        toast({ title: 'Aviso', description: 'Não foi possível verificar a sessão da mesa. Tente novamente.', duration: 4000 });
      }
    } catch (e) {
      console.error('Erro ao verificar sessão:', e);
      toast({ title: 'Erro de conexão', description: 'Falha ao contatar o servidor do ERP.', duration: 4000 });
    }
  };

  useEffect(() => {
    // load cardapio (tenta v2 com SKUs e faz fallback para v1)
    (async () => {
      try {
        const v2 = await fetch(`${apiConfig.erpBaseUrl}/api/public/cardapio/v2`);
        if (v2.ok) {
          const data = await v2.json();
          setCardapio(data);
          return;
        }
      } catch (e) {
        // segue pro fallback
      }

      try {
        const res = await fetch(`${apiConfig.erp.cardapio}`);
        if (res.ok) {
          const data = await res.json();
          setCardapio(data);
        }
      } catch (e) {
        console.error('Erro ao carregar cardápio', e);
      }
    })();
  }, []);

  // Observar visibilidade da seção "Seu carrinho" para mostrar/ocultar a barra fixa
  useEffect(() => {
    const el = cartSectionRef.current;
    if (!el) return;
    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      setCartSectionVisible(entry.isIntersecting);
    }, { threshold: 0.1 });
    observer.observe(el);
    return () => observer.disconnect();
  }, [cartSectionRef.current, tab, cart.length]);

  // Setas de navegação das categorias (scroll horizontal)
  useEffect(() => {
    const el = catScrollRef.current;
    if (!el) return;
    const update = () => {
      const maxScrollLeft = el.scrollWidth - el.clientWidth;
      setCatCanScrollLeft(el.scrollLeft > 4);
      setCatCanScrollRight(maxScrollLeft - el.scrollLeft > 4);
    };
    update();
    el.addEventListener('scroll', update);
    window.addEventListener('resize', update);
    return () => {
      el.removeEventListener('scroll', update);
      window.removeEventListener('resize', update);
    };
  }, [cardapio]);

  const connectSSE = (sessaoMesaId: number) => {
    try {
      if (sseRef.current) sseRef.current.close();
      const url = `${apiConfig.erpBaseUrl}/api/events/sessoes/${sessaoMesaId}`;
      const es = new EventSource(url);
      es.addEventListener('connected', () => console.debug('SSE conectado'));
      es.addEventListener('ping', () => {
        // Silent heartbeat - keep connection alive
      });
      es.addEventListener('table.closed', (evt: MessageEvent) => {
        console.debug('table.closed', evt.data);
        setSessionClosed(true);
        setCart([]);
        // limpar convidado para forçar novo ingresso
        try { localStorage.removeItem(storageKey); } catch {}
        setGuest(null);
        toast({
          title: 'Mesa encerrada',
          description: 'Esta sessão foi encerrada. Inicie uma nova para continuar.',
        });
      });
      es.addEventListener('guest.joined', (evt: MessageEvent) => {
        console.debug('guest.joined', evt.data);

        try {
          const data = JSON.parse(evt.data);
          const { sessaoConvidadoId, nomeExibicao } = data;

          // Notificar apenas o host sobre novos convidados (não notificar sobre si mesmo)
          const currentGuestId = guestIdRef.current;
          if (!currentGuestId || sessaoConvidadoId === currentGuestId) {
            // Não notificar sobre si mesmo
            return;
          }

          // Buscar guest atual para verificar se é host
          const savedGuest = localStorage.getItem(storageKey);
          if (savedGuest) {
            const guestData = JSON.parse(savedGuest);
            if (guestData.host) {
              const title = '👋 Novo convidado';
              const description = `${nomeExibicao} entrou na mesa`;

              // Show toast
              toast({
                title,
                description,
                duration: 5000,
              });

              // Show browser notification
              showNotification({
                title,
                body: description,
              });

              // Increment unread counter
              setUnreadNotifications((prev) => prev + 1);
            }
          }
        } catch (e) {
          console.warn('Erro ao processar guest.joined:', e);
        }
      });

      es.addEventListener('order.created', (evt: MessageEvent) => {
        console.debug('order.created', evt.data);

        try {
          const data = JSON.parse(evt.data);
          const { sessaoConvidadoId, nomeConvidado, itens } = data;

          // Buscar guest atual para verificar se é host e notificar sobre pedidos de outros
          const currentGuestId = guestIdRef.current;
          if (currentGuestId && sessaoConvidadoId !== currentGuestId) {
            const savedGuest = localStorage.getItem(storageKey);
            if (savedGuest) {
              const guestData = JSON.parse(savedGuest);
              if (guestData.host && Array.isArray(itens) && itens.length > 0) {
                const totalItens = itens.reduce((sum: number, item: any) => sum + (item.quantidade || 0), 0);
                const primeiroProduto = itens[0]?.produtoNome || 'item';
                const descricao = itens.length === 1
                  ? `${itens[0].quantidade}x ${primeiroProduto}`
                  : `${totalItens} itens (${primeiroProduto}${itens.length > 1 ? ' +' + (itens.length - 1) : ''})`;
                const title = `🍽️ Novo pedido de ${nomeConvidado}`;

                // Show toast
                toast({
                  title,
                  description: descricao,
                  duration: 6000,
                });

                // Show browser notification
                showNotification({
                  title,
                  body: descricao,
                });

                // Increment unread counter
                setUnreadNotifications((prev) => prev + 1);
              }
            }
          }
        } catch (e) {
          console.warn('Erro ao processar order.created:', e);
        }

        // Atualiza conta apenas se guestId conhecido
        // @ts-ignore
        if (guestIdRef && guestIdRef.current) refreshConta(guestIdRef.current as number);
      });
      es.addEventListener('kds.status_changed', (evt: MessageEvent) => {
        console.debug('kds.status_changed', evt.data);

        // Parse event data
        try {
          const data = JSON.parse(evt.data);
          const { itemPedidoId, status } = data;

          // Show toast if item was canceled
          if (status === 'canceled') {
            toast({
              title: '❌ Item cancelado',
              description: 'Um item do seu pedido foi cancelado. Entre em contato com o garçom para mais informações.',
              variant: 'destructive',
              duration: 7000,
            });
          }
        } catch (e) {
          console.warn('Erro ao parsear kds.status_changed:', e);
        }

        // Refresh conta to update the list
        // @ts-ignore
        if (guestIdRef && guestIdRef.current) refreshConta(guestIdRef.current as number);
      });
      es.addEventListener('payment.updated', (evt: MessageEvent) => {
        console.debug('payment.updated', evt.data);
        // @ts-ignore
        if (guestIdRef && guestIdRef.current) refreshConta(guestIdRef.current as number);
      });
      es.addEventListener('payment.registered', (evt: MessageEvent) => {
        console.debug('payment.registered', evt.data);

        try {
          const data = JSON.parse(evt.data);
          const { totalPago, devidoRestante } = data;

          // Show toast about payment
          toast({
            title: '💰 Pagamento registrado',
            description: `Pago: R$ ${(totalPago / 100).toFixed(2)} | Restante: R$ ${(devidoRestante / 100).toFixed(2)}`,
            duration: 5000,
          });
        } catch (e) {
          console.warn('Erro ao processar payment.registered:', e);
        }

        // Refresh conta to update amounts
        // @ts-ignore
        if (guestIdRef && guestIdRef.current) refreshConta(guestIdRef.current as number);
      });
      es.onerror = () => console.warn('SSE erro');
      sseRef.current = es;
    } catch (e) {
      console.warn('Falha SSE', e);
    }
  };

  const openProductDetails = (p: any) => {
    setDetailProduct(p);

    // Priorizar vídeo se existir, caso contrário mostrar imagem principal
    const videoMidia = p.midias?.find((m: any) => m.tipo === 'VIDEO');
    if (videoMidia) {
      setSelectedMedia({ type: 'video', url: videoMidia.url });
    } else if (p.imagemPrincipal) {
      setSelectedMedia({ type: 'image', url: p.imagemPrincipal });
    } else {
      setSelectedMedia(null);
    }

    setDetailsOpen(true);
  };

  const startAsGuest = async (overrideName?: string) => {
    if (!mesaSlug) return;
    const trimmed = ((overrideName ?? nome) || '').trim();
    if (trimmed.length < 2) {
      // validação simples
      alert('Informe seu nome (mínimo 2 caracteres) para continuar.');
      return;
    }
    setLoading(true);
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/mesas/${mesaSlug}/convidados`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        cache: 'no-store',
        body: JSON.stringify({ nomeExibicao: trimmed }),
      });
      if (!res.ok) {
        let errMsg = 'Falha ao criar convidado';
        try { const j = await res.json(); errMsg = j?.message || j?.error?.message || errMsg; } catch {}
        toast({ title: 'Não foi possível entrar', description: errMsg, duration: 5000 });
        throw new Error(errMsg);
      }
      const data = await res.json();
      const g: GuestSession = {
        sessaoConvidadoId: data.sessaoConvidadoId,
        sessaoMesaId: data.sessaoMesaId,
        guestToken: data.guestToken,
        nomeExibicao: trimmed,
        host: data.host === true,
      };
      setGuest(g);
      guestIdRef.current = g.sessaoConvidadoId;
      localStorage.setItem(storageKey, JSON.stringify(g));
      connectSSE(g.sessaoMesaId);
      refreshConta(g.sessaoConvidadoId);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const addToCart = (produtoId: number, nome: string, preco: number) => {
    setCart((prev) => {
      const idx = prev.findIndex((i) => i.produtoId === produtoId);
      if (idx >= 0) {
        const copy = [...prev];
        copy[idx] = { ...copy[idx], quantidade: copy[idx].quantidade + 1 };
        return copy;
      }
      return [...prev, { produtoId, nome, preco, quantidade: 1, observacoes: '' }];
    });
  };

  const addToCartSku = (skuId: number, productName: string, variacao: string | undefined, preco: number) => {
    const displayName = variacao ? `${productName} (${variacao})` : productName;
    setCart((prev) => {
      const idx = prev.findIndex((i) => (i.skuId ?? i.produtoId) === skuId);
      if (idx >= 0) {
        const copy = [...prev];
        copy[idx] = { ...copy[idx], quantidade: copy[idx].quantidade + 1 };
        return copy;
      }
      return [...prev, { produtoId: skuId, skuId, nome: displayName, preco, quantidade: 1, observacoes: '' }];
    });
  };

  const updateCartObservacoes = (itemId: number, observacoes: string) => {
    setCart((prev) => {
      const idx = prev.findIndex((i) => (i.skuId ?? i.produtoId) === itemId);
      if (idx >= 0) {
        const copy = [...prev];
        copy[idx] = { ...copy[idx], observacoes };
        return copy;
      }
      return prev;
    });
  };

  const removeFromCart = (itemId: number) => {
    setCart((prev) => prev.filter((i) => (i.skuId ?? i.produtoId) !== itemId));
  };

  const decreaseQuantity = (itemId: number) => {
    setCart((prev) => {
      const idx = prev.findIndex((i) => (i.skuId ?? i.produtoId) === itemId);
      if (idx >= 0) {
        const copy = [...prev];
        if (copy[idx].quantidade > 1) {
          copy[idx] = { ...copy[idx], quantidade: copy[idx].quantidade - 1 };
          return copy;
        } else {
          // Remove if quantity becomes 0
          return copy.filter((i) => (i.skuId ?? i.produtoId) !== itemId);
        }
      }
      return prev;
    });
  };

  const increaseQuantity = (itemId: number) => {
    setCart((prev) => {
      const idx = prev.findIndex((i) => (i.skuId ?? i.produtoId) === itemId);
      if (idx >= 0) {
        const copy = [...prev];
        copy[idx] = { ...copy[idx], quantidade: copy[idx].quantidade + 1 };
        return copy;
      }
      return prev;
    });
  };

  // Helpers para adicionar recomendados
  const resolvePrice = (p: any) => {
    if (typeof p.preco === 'number') return p.preco;
    if (typeof p.precoVenda === 'number') return p.precoVenda;
    const s = Array.isArray(p.skus) && p.skus.length > 0 ? p.skus[0] : null;
    if (s) {
      if (typeof s.preco === 'number') return s.preco;
      if (typeof s.precoVenda === 'number') return s.precoVenda;
    }
    return 0;
  };
  const handleAddRecommended = (p: any) => {
    try {
      if (Array.isArray(p.skus) && p.skus.length > 1) {
        const s = p.skus[0];
        const sp = typeof s.preco === 'number' ? s.preco : (typeof s.precoVenda === 'number' ? s.precoVenda : 0);
        addToCartSku(s.id, p.nome, s.variacao, sp);
      } else {
        const price = resolvePrice(p);
        addToCart(p.id, p.nome, price);
      }
    } catch (e) {
      console.warn('Erro ao adicionar recomendado:', e);
    }
  };

  const sendOrder = async () => {
    if (!guest || cart.length === 0) return;
    setLoading(true);
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/pedidos`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Guest-Token': guest.guestToken,
          'X-Sessao-Mesa': String(guest.sessaoMesaId),
        },
        body: JSON.stringify({
          itens: cart.map((c) => {
            const trimmedObs = (c.observacoes || '').trim();
            const isSku = !!c.skuId;
            return {
              produtoId: isSku ? null : c.produtoId,
              skuId: isSku ? c.skuId : null,
              quantidade: c.quantidade,
              observacoes: trimmedObs.length > 0 ? trimmedObs : null,
            };
          }),
        }),
      });
      if (!res.ok) throw new Error('Falha ao enviar pedido');
      setCart([]);
      refreshConta(guest.sessaoConvidadoId);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const refreshConta = async (sessaoConvidadoId: number) => {
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/conta?sessaoConvidadoId=${sessaoConvidadoId}`);
      if (res.ok) {
        const data = await res.json();
        setConta(data);
      } else {
        // tenta identificar sessão encerrada
        try {
          const err = await res.json();
          const code = err?.error?.code;
          if (code === 'session_closed') {
            setSessionClosed(true);
            setCart([]);
            try { localStorage.removeItem(storageKey); } catch {}
            setGuest(null);
            toast({
              title: 'Mesa encerrada',
              description: 'Esta sessão foi encerrada. Inicie uma nova para continuar.',
            });
          }
        } catch {}
      }
    } catch (e) {
      console.error(e);
    }
  };

  const refreshContaMesa = async (sessaoMesaId: number) => {
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/conta?sessaoMesaId=${sessaoMesaId}`);
      if (res.ok) {
        const data = await res.json();
        setContaMesa(data);
      }
    } catch (e) {
      console.error(e);
    }
  };

  const pagarMeuTotal = async () => {
    if (!guest) return;
    try {
      const contaRes = await fetch(`${apiConfig.erpBaseUrl}/api/conta?sessaoConvidadoId=${guest.sessaoConvidadoId}`);
      if (!contaRes.ok) return;
      const c = await contaRes.json();
      const valor = c.devidoCentavos as number;
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/pagamentos/intent`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          escopo: 'convidado',
          sessaoConvidadoId: guest.sessaoConvidadoId,
          sessaoMesaId: guest.sessaoMesaId,
          valorCentavos: valor,
        }),
      });
      if (res.ok) {
        const data = await res.json();
        setQrPayload(data.qrPayload || '');
      }
    } catch (e) {
      console.error(e);
    }
  };

  const chamarGarcom = async () => {
    if (!guest) return;
    try {
      const res = await fetch(`${apiConfig.erpBaseUrl}/api/chamados`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Guest-Token': guest.guestToken,
        },
        body: JSON.stringify({
          sessaoMesaId: guest.sessaoMesaId,
          tipo: 'garcom',
        }),
      });
      if (res.ok) {
        toast({
          title: '🔔 Garçom chamado',
          description: 'Um garçom será atendido em breve.',
          duration: 4000,
        });
      } else {
        throw new Error('Falha ao chamar garçom');
      }
    } catch (e) {
      console.error(e);
      toast({
        title: 'Erro',
        description: 'Não foi possível chamar o garçom. Tente novamente.',
        variant: 'destructive',
      });
    }
  };

  // UI helpers
  const badgeClass = (status?: string) => {
    switch ((status || '').toLowerCase()) {
      case 'queued': return 'bg-gray-100 text-gray-700';
      case 'pending': return 'bg-gray-100 text-gray-700';
      case 'accepted': return 'bg-blue-100 text-blue-700';
      case 'preparing': return 'bg-amber-100 text-amber-700';
      case 'ready': return 'bg-emerald-100 text-emerald-700';
      case 'delivered': return 'bg-green-100 text-green-700';
      case 'canceled': return 'bg-red-100 text-red-700';
      default: return 'bg-gray-100 text-gray-700';
    }
  };

  const statusLabel = (status?: string) => {
    switch ((status || '').toLowerCase()) {
      case 'queued': return 'Pendente';
      case 'pending': return 'Pendente';
      case 'accepted': return 'Aceito';
      case 'preparing': return 'Preparando';
      case 'ready': return 'Pronto';
      case 'delivered': return 'Entregue';
      case 'canceled': return 'Cancelado';
      default: return (status || '');
    }
  };

  const filteredCategories = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q && selectedCategoryId === 'all') return cardapio;
    return cardapio
      .map(cat => ({
        ...cat,
        produtos: (cat.produtos || []).filter((p: any) => {
          const price = typeof p.preco === 'number' ? p.preco : (typeof p.precoVenda === 'number' ? p.precoVenda : undefined);
          const hasSkuPrice = Array.isArray(p.skus) && p.skus.some((s: any) => typeof s.preco === 'number' || typeof s.precoVenda === 'number');
          const nameMatch = p.nome?.toLowerCase().includes(q);
          const catMatch = selectedCategoryId === 'all' || cat.id === selectedCategoryId;
          const hasPrice = typeof price === 'number' || hasSkuPrice;
          return (q ? nameMatch : true) && catMatch && hasPrice;
        })
      }))
      .filter(cat => (cat.produtos && cat.produtos.length > 0));
  }, [cardapio, search, selectedCategoryId]);

  // Gate de identificação: se não há convidado (não exibimos cardápio/abas ainda)
  if (!guest) {
    return (
      <div className="min-h-screen bg-forest-dark text-cream flex items-center">
        <div className="max-w-md mx-auto px-6 py-10 w-full">
          <div className="mb-6">
            <div className="text-[11px] tracking-widest text-coral-accent/80 uppercase">Mesa</div>
            <h1 className="text-2xl font-display tracking-wider leading-tight">{mesaSlug}</h1>
          </div>
          {/* Auto-join loader quando autenticado como CLIENTE */}
          {autoJoinInProgress && isAuthenticated && user?.roles?.includes('CLIENTE') && (
            <div className="mb-6 border border-coral-accent/40 rounded-lg p-4 bg-coral-accent/10">
              <h2 className="text-lg font-medium mb-2 flex items-center gap-2">
                <span>🔐</span>
                <span>Conectando você à mesa...</span>
              </h2>
              <p className="text-sm text-cream/90">Aguarde um instante enquanto concluímos seu ingresso como {nome || 'convidado'}.</p>
            </div>
          )}

          {/* Diálogo de sessão ativa (oculto durante auto-join) */}
          {!autoJoinInProgress && showConfirmDialog && sessaoAtiva && (
            <div className="mb-6 border border-coral-accent/40 rounded-lg p-4 bg-coral-accent/10">
              <h2 className="text-lg font-medium mb-2 flex items-center gap-2">
                <span>⚠️</span>
                <span>Sessão Ativa</span>
              </h2>
              <p className="text-sm text-cream/90 mb-4">
                A {sessaoAtiva.mesaRotulo} já possui uma sessão ativa com <strong>{sessaoAtiva.totalConvidados} {sessaoAtiva.totalConvidados === 1 ? 'pessoa' : 'pessoas'}</strong>.
              </p>
              <p className="text-sm text-cream/90 mb-4">
                Ao continuar, você participará desta sessão e poderá fazer pedidos compartilhados.
              </p>
              <div className="flex gap-2">
                <button
                  onClick={() => {
                    setShowConfirmDialog(false);
                    setSessaoAtiva(null);
                  }}
                  className="flex-1 border border-coral-accent/30 hover:bg-cream/10 text-cream px-4 py-2 rounded"
                >
                  Cancelar
                </button>
                <button
                  onClick={() => setShowConfirmDialog(false)}
                  className="flex-1 bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded font-medium"
                >
                  Confirmar e Participar
                </button>
              </div>
            </div>
          )}

          {/* Form de identificação só aparece se não estiver auto-join em progresso */}
          <div className="mb-6">
            <h2 className="text-lg font-medium mb-2">Antes de começar</h2>
            {autoJoinInProgress && isAuthenticated && user?.roles?.includes('CLIENTE') ? (
              <p className="text-sm text-cream/70">Finalizando sua entrada automaticamente...</p>
            ) : (
              !sessionClosed ? (
                <p className="text-sm text-cream/70">Informe seu nome para que possamos identificar seus pedidos nesta mesa.</p>
              ) : (
                <p className="text-sm text-cream/70">Esta mesa foi encerrada. Para iniciar uma nova sessão, informe seu nome abaixo.</p>
              )
            )}
          </div>

          {!autoJoinInProgress && (
            <div className="space-y-3">
              <input
                className="w-full border border-coral-accent/30 bg-transparent rounded px-3 py-3 placeholder:text-cream/50"
                placeholder="Seu nome"
                value={nome}
                onChange={(e) => setNome(e.target.value)}
              />
              <button
                className="w-full bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-3 rounded"
                disabled={loading || (nome.trim().length < 2)}
                onClick={() => startAsGuest()}
              >
                Entrar
              </button>
            </div>
          )}

          {!autoJoinInProgress && (
            <div className="my-6 flex items-center gap-3">
              <div className="h-px flex-1 bg-coral-accent/20" />
              <div className="text-xs text-cream/60">ou</div>
              <div className="h-px flex-1 bg-coral-accent/20" />
            </div>
          )}

          {!autoJoinInProgress && (
            <button
              type="button"
              onClick={handleGoogleLoginOnMesa}
              className="w-full border border-coral-accent/30 hover:bg-coral-accent/10 text-cream px-4 py-3 rounded flex items-center justify-center gap-2"
            >
              <span>Continuar com Google</span>
            </button>
          )}

          {!autoJoinInProgress && (
            <div className="mt-4 text-xs text-cream/60">
              Ao entrar com Google você poderá acessar benefícios da Área do Cliente (histórico de pedidos, favoritos, reservas e mais).
            </div>
          )}
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-forest-dark text-cream">
      <div className="max-w-md mx-auto px-4 py-4 pb-24">
      {/* Header */}
      <div className="flex items-center justify-between mb-3">
        {/* Info da Mesa */}
        <div>
          <div className="text-[11px] tracking-widest text-coral-accent/80 uppercase">Mesa</div>
          <h1 className="text-xl font-display tracking-wider leading-tight">{mesaSlug}</h1>
          {guest && (
            <div className="text-xs text-cream/70">Olá, {guest.nomeExibicao}</div>
          )}
        </div>

        <div className="flex items-center gap-2">
          {guest?.host && (
            <NotificationBadge
              guestToken={guest.guestToken}
              unreadCount={unreadNotifications}
              onCountUpdate={(count) => setUnreadNotifications(count)}
            />
          )}
          <button className="flex items-center gap-2 px-3 py-1.5 rounded hover:bg-coral-accent/10 transition" title="Chamar garçom" onClick={chamarGarcom}>🔔 <span className="text-sm">Chamar</span></button>

          {/* Avatar com setinha */}
          <button
            onClick={() => setShowUserMenu(true)}
            className="flex items-center gap-1 px-2 py-1 rounded hover:bg-coral-accent/10 transition"
          >
            {isAuthenticated && user?.fotoPerfil ? (
              <img
                src={user.fotoPerfil}
                alt={user.nome}
                className="w-8 h-8 rounded-full object-cover"
              />
            ) : (
              <div className="w-8 h-8 rounded-full bg-coral-accent/20 flex items-center justify-center text-sm font-medium text-cream">
                {guest?.nomeExibicao?.[0]?.toUpperCase() || '?'}
              </div>
            )}
            <ChevronDown className="w-4 h-4 text-cream/70" />
          </button>
        </div>
      </div>

      {!guest && (
        <div className="mb-3 flex gap-2">
          <input className="border border-coral-accent/30 bg-transparent rounded px-3 py-2 flex-1 placeholder:text-cream/50" placeholder="Seu nome (opcional)" value={nome} onChange={(e)=>setNome(e.target.value)} />
          <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded" disabled={loading} onClick={startAsGuest}>Entrar</button>
        </div>
      )}

      {/* Tabs */}
      <div className="flex items-center gap-2 border-b border-coral-accent/20 mb-3 overflow-x-auto no-scrollbar">
        {[
          { key: 'menu', label: 'Menu' },
          { key: 'pedidos', label: 'Meus pedidos' },
          { key: 'conta', label: 'Minha conta' },
        ].map(t => (
          <button key={t.key}
                  className={`px-3 py-2 text-sm whitespace-nowrap border-b-2 ${tab===t.key ? 'border-coral-accent text-coral-accent' : 'border-transparent text-cream/60'}`}
                  onClick={() => setTab(t.key as any)}>
            {t.label}
          </button>
        ))}
      </div>

      {/* Tab: Menu */}
      {tab==='menu' && (
        <div>
          <div className="mb-3 flex gap-2">
            <input className="border border-coral-accent/30 bg-transparent rounded px-3 py-2 flex-1 placeholder:text-cream/50" placeholder="Buscar no cardápio" value={search} onChange={e=>setSearch(e.target.value)} />
          </div>
          <div className="mb-3 relative">
            <div ref={catScrollRef} className="flex gap-2 overflow-x-auto no-scrollbar pr-10">
              <button className={`px-3 py-1.5 rounded border border-coral-accent/30 ${selectedCategoryId==='all' ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>setSelectedCategoryId('all')}>Tudo</button>
              {cardapio.map(cat => (
                <button key={cat.id} className={`px-3 py-1.5 rounded border border-coral-accent/30 whitespace-nowrap ${selectedCategoryId===cat.id ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>setSelectedCategoryId(cat.id)}>{cat.nome}</button>
              ))}
            </div>
            {/* Gradientes nas bordas indicando overflow */}
            {catCanScrollLeft && (
              <div className="pointer-events-none absolute left-0 top-0 bottom-0 w-6 bg-gradient-to-r from-forest-dark to-transparent" />
            )}
            {catCanScrollRight && (
              <div className="pointer-events-none absolute right-0 top-0 bottom-0 w-6 bg-gradient-to-l from-forest-dark to-transparent" />
            )}
            {catCanScrollLeft && (
              <button
                aria-label="Mais à esquerda"
                className="absolute left-1 top-1/2 -translate-y-1/2 z-10 h-8 w-8 flex items-center justify-center rounded-full bg-forest-dark/80 border border-coral-accent/30 text-cream"
                onClick={() => { const el = catScrollRef.current; if (el) el.scrollBy({ left: -180, behavior: 'smooth' }); }}
              >
                <ChevronLeft className="w-4 h-4" />
              </button>
            )}
            {catCanScrollRight && (
              <button
                aria-label="Mais à direita"
                className="absolute right-1 top-1/2 -translate-y-1/2 z-10 h-8 w-8 flex items-center justify-center rounded-full bg-forest-dark/80 border border-coral-accent/30 text-cream"
                onClick={() => { const el = catScrollRef.current; if (el) el.scrollBy({ left: 180, behavior: 'smooth' }); }}
              >
                <ChevronRight className="w-4 h-4" />
              </button>
            )}
          </div>

          {/* Mensagem quando não há itens para exibir */}
          {filteredCategories.length === 0 && (
            <div className="border border-coral-accent/20 rounded p-3 bg-coral-accent/5 text-sm text-cream/70">
              {selectedCategoryId === 'all' ? 'Nenhum item encontrado.' : 'Sem itens nesta categoria.'}
            </div>
          )}

          <div className="space-y-4">
            {filteredCategories.map((cat) => (
              <div key={cat.id}>
                <h2 className="text-base font-medium mb-2">{cat.nome}</h2>
                <div className="grid grid-cols-1 gap-2">
                  {cat.produtos?.map((p) => {
                    const price = typeof (p as any).preco === 'number' ? (p as any).preco : (typeof (p as any).precoVenda === 'number' ? (p as any).precoVenda : undefined);
                    return (
                    <div key={p.id} className="border border-coral-accent/20 rounded p-2 bg-coral-accent/5">
                      <div className="flex items-center gap-3">
                        {/* Thumb */}
                        <button onClick={() => openProductDetails(p)} className="shrink-0">
                          <img
                            src={apiConfig.getMediaUrl((p as any).imagemPrincipal) || ''}
                            alt={p.nome}
                            className="w-12 h-12 sm:w-14 sm:h-14 rounded object-cover bg-forest-dark/20 border border-coral-accent/20"
                            onError={(e)=>{(e.currentTarget as HTMLImageElement).style.visibility='hidden';}}
                          />
                        </button>
                        {/* Info + actions */}
                        <div className="flex-1">
                          <button onClick={() => openProductDetails(p)} className="text-left">
                            <div className="font-medium text-sm sm:text-base leading-tight">{p.nome}</div>
                            {Array.isArray((p as any).skus) && (p as any).skus.length > 1 ? (
                              <div className="text-[11px] sm:text-xs text-cream/60">Escolha uma variação • Ver detalhes</div>
                            ) : (
                              typeof price === 'number' && (
                                <div className="text-xs sm:text-sm text-cream/70">R$ {price.toFixed(2)} • Ver detalhes</div>
                              )
                            )}
                          </button>

                          {/* Variações inline (quando >1) */}
                          {Array.isArray((p as any).skus) && (p as any).skus.length > 1 && (
                            <div className="mt-2 grid grid-cols-1 gap-2">
                              {((p as any).skus as any[]).map((s) => {
                                const sp = typeof s.preco === 'number' ? s.preco : (typeof s.precoVenda === 'number' ? s.precoVenda : 0);
                                return (
                                  <div key={s.id} className="flex items-center justify-between border border-coral-accent/20 rounded p-2 bg-transparent">
                                    <div className="text-xs sm:text-sm text-cream/90">{s.variacao || 'Opção'} {typeof sp === 'number' && <span className="text-cream/70">• R$ {sp.toFixed(2)}</span>}</div>
                                    <button className="border border-coral-accent/30 px-2 py-1 rounded text-xs sm:text-sm hover:bg-coral-accent/10" onClick={() => addToCartSku(s.id, p.nome, s.variacao, typeof sp === 'number' ? sp : 0)} disabled={!guest}>Adicionar</button>
                                  </div>
                                );
                              })}
                            </div>
                          )}
                        </div>

                        {/* Botão rápido (apenas 1 SKU) */}
                        {(!Array.isArray((p as any).skus) || (p as any).skus.length <= 1) && (
                          <button className="border border-coral-accent/30 px-2 py-1 rounded text-xs sm:text-sm hover:bg-coral-accent/10" onClick={() => addToCart(p.id, p.nome, typeof price === 'number' ? price : 0)} disabled={!guest}>Adicionar</button>
                        )}
                      </div>
                    </div>
                  );})}
                </div>
              </div>
            ))}
          </div>

          <div ref={cartSectionRef} className="mt-6 border-t border-coral-accent/20 pt-4">
            <h3 className="font-medium mb-2">Seu carrinho</h3>
            {cart.length === 0 && <div className="text-sm text-gray-600">Vazio</div>}
            {cart.length > 0 && (
              <div className="space-y-4">
                  {cart.map((c) => {
                    const keyId = c.skuId ?? c.produtoId;
                    return (
                    <div key={keyId} className="border border-coral-accent/20 rounded p-2 sm:p-3 bg-coral-accent/5">
                      <div className="flex justify-between items-start mb-2">
                        <div className="flex-1">
                          <div className="font-medium text-xs sm:text-sm">{c.nome}</div>
                          <div className="text-[11px] sm:text-xs text-cream/70">R$ {c.preco.toFixed(2)} cada</div>
                        </div>
                        <button
                          onClick={() => removeFromCart(keyId)}
                          className="text-red-400 hover:text-red-300 px-2 py-1 text-sm"
                          title="Remover item"
                        >
                          ✕
                        </button>
                      </div>

                      <div className="flex items-center justify-between mb-2 gap-2">
                        <div className="flex items-center gap-2">
                          <button
                            onClick={() => decreaseQuantity(keyId)}
                            className="border border-coral-accent/30 px-2 py-1 rounded hover:bg-coral-accent/10 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center"
                          >
                            −
                          </button>
                          <span className="text-xs sm:text-sm font-medium w-7 sm:w-8 text-center">{c.quantidade}</span>
                          <button
                            onClick={() => increaseQuantity(keyId)}
                            className="border border-coral-accent/30 px-2 py-1 rounded hover:bg-coral-accent/10 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center"
                          >
                            +
                          </button>
                        </div>
                        <ObservationEditor value={c.observacoes || ''} onChange={(v) => updateCartObservacoes(keyId, v)} />
                        <div className="font-medium text-sm sm:text-base whitespace-nowrap">R$ {(c.preco * c.quantidade).toFixed(2)}</div>
                      </div>
                      
                    </div>
                  );})}
                <div className="border-t border-coral-accent/20 pt-3">
                  <div className="flex justify-between font-medium mb-3 text-sm sm:text-base">
                    <span>Total</span>
                    <span>R$ {cart.reduce((sum, c) => sum + c.preco * c.quantidade, 0).toFixed(2)}</span>
                  </div>
                  <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded w-full" onClick={sendOrder} disabled={loading || !guest}>Enviar pedido</button>
                </div>
              </div>
            )}
          </div>
      </div>
      )}

      {/* Tab: Meus pedidos */}
      {tab==='pedidos' && guest && (
        <div>
          <div className="flex items-center gap-2 mb-3">
            <button className={`px-3 py-1.5 rounded border border-coral-accent/30 ${pedidosView==='mine' ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>setPedidosView('mine')}>Meus</button>
            <button className={`px-3 py-1.5 rounded border border-coral-accent/30 ${pedidosView==='mesa' ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>{ setPedidosView('mesa'); refreshContaMesa(guest.sessaoMesaId); }}>Mesa</button>
          </div>
          {pedidosView==='mine' && conta?.itens && conta.itens.length > 0 && (
          <div className="space-y-3 text-sm">
            {Object.entries(
              (conta.itens || []).reduce<Record<string, typeof conta.itens>>((acc, it) => {
                const key = String(it.pedidoId);
                acc[key] = acc[key] || [];
                acc[key].push(it);
                return acc;
              }, {})
            ).sort((a,b) => {
              const d1 = new Date(a[1][0].pedidoCriadoEm).getTime();
              const d2 = new Date(b[1][0].pedidoCriadoEm).getTime();
              return d2 - d1;
            }).map(([pedidoId, itens]) => {
              const created = new Date(itens[0].pedidoCriadoEm).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
              const status = itens[0].pedidoStatus;
              return (
                <div key={pedidoId} className="border border-coral-accent/20 rounded bg-coral-accent/5">
                  <div className="flex items-center justify-between px-3 py-2 bg-coral-accent/5 rounded-t">
                    <div className="font-medium">Pedido #{pedidoId}</div>
                    <div className={`text-xs px-2 py-0.5 rounded ${badgeClass(status)}`}>{statusLabel(status)}</div>
                  </div>
                  <div className="px-3 py-2 text-xs text-cream/60">Feito em {created}</div>
                  <div className="divide-y">
                    {itens.map(it => {
                      const isCanceled = it.status?.toLowerCase() === 'canceled';
                      return (
                        <div key={it.itemPedidoId} className={`px-3 py-2 ${isCanceled ? 'opacity-60' : ''}`}>
                          <div className="flex justify-between">
                            <div>
                              <div className={`font-medium ${isCanceled ? 'line-through' : ''}`}>{it.produtoNome}</div>
                              <div className="text-cream/70">Qtd: {it.quantidade} • <span className={`px-1 rounded ${badgeClass(it.status)}`}>{statusLabel(it.status)}</span></div>
                              {it.observacoes && (
                                <div className="text-xs text-cream/60 italic mt-1 flex items-center gap-1">
                                  <span>📝</span>
                                  <span>{it.observacoes}</span>
                                </div>
                              )}
                              {isCanceled && (
                                <div className="text-xs text-red-400 mt-1 flex items-center gap-1">
                                  <span>❌</span>
                                  <span>Item cancelado - Entre em contato com o garçom</span>
                                </div>
                              )}
                            </div>
                            <div className={isCanceled ? 'line-through' : ''}>R$ {((it.precoUnitCentavos * it.quantidade)/100).toFixed(2)}</div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
          )}

          {pedidosView==='mesa' && contaMesa && contaMesa.pessoas && (
            <MesaPedidosList sessaoMesaId={guest.sessaoMesaId} pessoas={contaMesa.pessoas} />
          )}
        </div>
      )}

      {/* Tab: Minha conta */}
      {tab==='conta' && guest && (
        <div>
          <div className="flex items-center gap-2 mb-3">
            <button className={`px-3 py-1.5 rounded border border-coral-accent/30 ${contaView==='mine' ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>setContaView('mine')}>Minha conta</button>
            <button className={`px-3 py-1.5 rounded border border-coral-accent/30 ${contaView==='mesa' ? 'bg-coral-accent text-forest-dark' : 'text-cream/80'}`} onClick={()=>{ setContaView('mesa'); refreshContaMesa(guest.sessaoMesaId); }}>Conta da mesa</button>
          </div>
          {contaView==='mine' && (
            <>
              <div className="flex items-center gap-2 mb-2">
                <button className="border border-coral-accent/30 px-3 py-1 rounded hover:bg-coral-accent/10" onClick={() => refreshConta(guest.sessaoConvidadoId)}>Atualizar</button>
              </div>
              {conta && (
                <div className="text-sm space-y-1">
                  <div>Subtotal: R$ {(conta.subtotalCentavos / 100).toFixed(2)}</div>
                  <div>Pago: R$ {(conta.pagoCentavos / 100).toFixed(2)}</div>
                  <div>Devido: R$ {(conta.devidoCentavos / 100).toFixed(2)}</div>
                </div>
              )}
              <div className="mt-3">
                <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded w-full" onClick={pagarMeuTotal} disabled={!conta || (conta?.devidoCentavos ?? 0) <= 0}>Pagar meu total (PIX)</button>
              </div>
              {qrPayload && (
                <div className="mt-3 grid grid-cols-1 gap-3 items-start">
                  <div>
                    <div className="text-sm font-medium mb-2">QR Code (PIX)</div>
                    {qrImageUrl && (
                      <img src={qrImageUrl} alt="QR Code PIX" className="w-60 h-60 border rounded bg-white" />
                    )}
                  </div>
                  <div>
                    <div className="text-sm text-cream/70 mb-1">Ou copie e cole o código PIX:</div>
                    <textarea className="w-full border border-coral-accent/30 bg-transparent rounded p-2 text-xs" rows={8} readOnly value={qrPayload} />
                  </div>
                </div>
              )}
            </>
          )}

          {contaView==='mesa' && contaMesa && (
            <div>
              <div className="text-sm space-y-1">
                <div>Total da mesa: R$ {(contaMesa.totalMesaCentavos/100).toFixed(2)}</div>
                <div>Pago: R$ {(contaMesa.pagoCentavos/100).toFixed(2)}</div>
                <div>Devido: R$ {(contaMesa.devidoCentavos/100).toFixed(2)}</div>
              </div>
              <div className="mt-3 grid grid-cols-1 gap-2">
                <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded w-full"
                        onClick={async ()=>{
                          const due = contaMesa?.devidoCentavos || 0;
                          const res = await fetch(`${apiConfig.erpBaseUrl}/api/pagamentos/intent`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ escopo:'mesa', sessaoMesaId: guest.sessaoMesaId, valorCentavos: due })});
                          if (res.ok) { const data = await res.json(); setQrPayload(data.qrPayload); }
                        }}
                        disabled={!contaMesa || (contaMesa.devidoCentavos ?? 0) <= 0}>
                  Pagar total da mesa (PIX)
                </button>
                {/* Botão "Fechar mesa" removido (encerramento automático ao quitar) */}
                {/* Pagar para outra pessoa */}
                {contaMesa.pessoas?.length > 1 && (
                  <div className="border border-coral-accent/20 rounded p-2">
                    <div className="text-sm mb-2">Pagar para outra pessoa</div>
                    <div className="space-y-2">
                      {contaMesa.pessoas.map(p => (
                        <button key={p.sessaoConvidadoId} className="w-full border border-coral-accent/30 px-3 py-2 rounded flex items-center justify-between hover:bg-coral-accent/10"
                                onClick={async ()=>{
                                  const res = await fetch(`${apiConfig.erpBaseUrl}/api/conta?sessaoConvidadoId=${p.sessaoConvidadoId}`);
                                  if (!res.ok) return; const data = await res.json();
                                  const due = data?.devidoCentavos || 0;
                                  const r2 = await fetch(`${apiConfig.erpBaseUrl}/api/pagamentos/intent`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ escopo:'convidado', sessaoConvidadoId: p.sessaoConvidadoId, sessaoMesaId: guest.sessaoMesaId, valorCentavos: due })});
                                  if (r2.ok) { const d = await r2.json(); setQrPayload(d.qrPayload); }
                                }}>
                          <span>{p.nome || (p as any).name || `Convidado ${p.sessaoConvidadoId}`}</span>
                          <span className="text-xs">Devido: R$ {((p.devidoCentavos||0)/100).toFixed(2)}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {qrPayload && (
                <div className="mt-3 grid grid-cols-1 gap-3 items-start">
                  <div>
                    <div className="text-sm font-medium mb-2">QR Code (PIX)</div>
                    {qrImageUrl && (<img src={qrImageUrl} alt="QR Code PIX" className="w-60 h-60 border rounded bg-white" />)}
                  </div>
                  <div>
                    <div className="text-sm text-cream/70 mb-1">Ou copie e cole o código PIX:</div>
                    <textarea className="w-full border border-coral-accent/30 bg-transparent rounded p-2 text-xs" rows={8} readOnly value={qrPayload} />
                  </div>
                </div>
              )}
            </div>
          )}
      </div>
      )}
      </div>

      {/* Dialog de detalhes do produto */}
      <Dialog open={detailsOpen} onOpenChange={setDetailsOpen}>
        <DialogContent className="bg-forest-dark text-cream border border-coral-accent/20 w-[92vw] sm:w-auto max-w-2xl max-h-[92vh] overflow-hidden">
          {detailProduct && (() => {
            // Preparar mídias: vídeo + todas as imagens (principal + galeria)
            const videoMidia = detailProduct.midias?.find((m: any) => m.tipo === 'VIDEO');
            const imagensMidias = detailProduct.midias?.filter((m: any) => m.tipo === 'IMAGEM') || [];

            // Montar lista de todas as imagens (principal primeiro, depois galeria)
            const allImages: string[] = [];
            if (detailProduct.imagemPrincipal) {
              allImages.push(detailProduct.imagemPrincipal);
            }
            imagensMidias.forEach((m: any) => {
              if (m.url && m.url !== detailProduct.imagemPrincipal) {
                allImages.push(m.url);
              }
            });

            const hasMedia = videoMidia || allImages.length > 0;

            return (
              <div className="space-y-4">
                <DialogHeader>
                  <DialogTitle className="text-cream text-base sm:text-lg">{detailProduct.nome}</DialogTitle>
                  <DialogDescription className="text-cream/70 text-[13px] sm:text-sm">
                    {detailProduct.descricao || 'Sem descrição.'}
                  </DialogDescription>
                </DialogHeader>

                {/* Layout: Mídia principal + Galeria de miniaturas */}
                {hasMedia && (
                  <div className="flex gap-3 items-start">
                    {/* Área principal - Vídeo ou Imagem */}
                    <div className="flex-1">
                      {selectedMedia?.type === 'video' ? (
                        <video
                          src={apiConfig.getMediaUrl(selectedMedia.url)}
                          controls
                          className="w-full h-[36vh] sm:h-[40vh] rounded border border-coral-accent/20 bg-black object-contain"
                          autoPlay={false}
                        >
                          Seu navegador não suporta vídeo.
                        </video>
                      ) : selectedMedia?.type === 'image' ? (
                        <img
                          src={apiConfig.getMediaUrl(selectedMedia.url)}
                          alt={detailProduct.nome}
                          className="w-full h-[36vh] sm:h-[40vh] object-contain rounded border border-coral-accent/20"
                        />
                      ) : null}
                    </div>

                    {/* Galeria de miniaturas */}
                    {(videoMidia || allImages.length > 1) && (
                      <div className="flex flex-col gap-2 w-20 max-h-[36vh] sm:max-h-[40vh] overflow-hidden">
                        {/* Miniatura do vídeo */}
                        {videoMidia && (
                          <button
                            onClick={() => setSelectedMedia({ type: 'video', url: videoMidia.url })}
                            className={`relative w-20 h-20 rounded border-2 overflow-hidden ${
                              selectedMedia?.type === 'video' && selectedMedia.url === videoMidia.url
                                ? 'border-coral-accent'
                                : 'border-coral-accent/20'
                            }`}
                          >
                            <div className="absolute inset-0 bg-black/60 flex items-center justify-center">
                              <svg className="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
                              </svg>
                            </div>
                          </button>
                        )}

                        {/* Miniaturas das imagens */}
                        {allImages.map((imgUrl, idx) => (
                          <button
                            key={idx}
                            onClick={() => setSelectedMedia({ type: 'image', url: imgUrl })}
                            className={`w-20 h-20 rounded border-2 overflow-hidden ${
                              selectedMedia?.type === 'image' && selectedMedia.url === imgUrl
                                ? 'border-coral-accent'
                                : 'border-coral-accent/20'
                            }`}
                          >
                            <img
                              src={apiConfig.getMediaUrl(imgUrl)}
                              alt={`${detailProduct.nome} ${idx + 1}`}
                              className="w-full h-full object-cover"
                            />
                          </button>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {/* Preço único ou variações */}
                {Array.isArray(detailProduct.skus) && detailProduct.skus.length > 1 ? (
                  <div className="space-y-2">
                    {detailProduct.skus.map((s: any) => {
                      const sp = typeof s.preco === 'number' ? s.preco : (typeof s.precoVenda === 'number' ? s.precoVenda : 0);
                      return (
                        <div key={s.id} className="flex items-center justify-between border border-coral-accent/20 rounded p-2">
                          <div className="text-xs sm:text-sm">{s.variacao || 'Opção'} <span className="text-cream/70">• R$ {sp.toFixed(2)}</span></div>
                          <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-3 py-1 rounded text-xs sm:text-sm" onClick={() => { addToCartSku(s.id, detailProduct.nome, s.variacao, sp); setDetailsOpen(false); }} disabled={!guest}>Adicionar</button>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                <div className="flex items-center justify-between border border-coral-accent/20 rounded p-3">
                  <div className="text-xs sm:text-sm">Preço <span className="text-cream/70">R$ {(((detailProduct as any).preco ?? (detailProduct as any).precoVenda) || 0).toFixed(2)}</span></div>
                  <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-3 py-1 rounded text-xs sm:text-sm" onClick={() => { const p = typeof (detailProduct as any).preco === 'number' ? (detailProduct as any).preco : (typeof (detailProduct as any).precoVenda === 'number' ? (detailProduct as any).precoVenda : 0); addToCart(detailProduct.id, detailProduct.nome, p); setDetailsOpen(false); }} disabled={!guest}>Adicionar</button>
                </div>
                )}

                {/* Harmoniza com (Mock) — apenas mobile (oculto em sm+) */}
                <div className="mt-4 block sm:hidden">
                  <div className="flex items-center justify-between mb-2">
                    <div className="text-sm font-medium">Harmoniza com</div>
                    <div className="text-[11px] text-cream/60">Sugestões da casa</div>
                  </div>
                  {pairingsLimited.length === 0 ? (
                    <div className="text-xs text-cream/60">Sem recomendações no momento.</div>
                  ) : (
                    <div className="no-scrollbar overflow-x-auto snap-x snap-mandatory w-full max-w-full">
                      <div className="inline-flex gap-2">
                        {pairingsLimited.map((rp: any, idx: number) => {
                          const price = resolvePrice(rp);
                          return (
                            <div key={rp.id + '-' + idx} className="snap-start w-32 sm:w-40 shrink-0 border border-coral-accent/20 rounded bg-coral-accent/5">
                              <div className="relative bg-forest-dark/20 rounded-t">
                                <img
                                  src={apiConfig.getMediaUrl(rp.imagemPrincipal) || ''}
                                  alt={rp.nome}
                                  className="w-32 sm:w-40 h-20 sm:h-24 object-cover rounded-t"
                                  onError={(e)=>{(e.currentTarget as HTMLImageElement).style.visibility='hidden';}}
                                />
                              </div>
                              <div className="p-1.5">
                                <div className="text-[11px] font-medium leading-tight line-clamp-2" title={rp.nome}>{rp.nome}</div>
                                {rp.nota && <div className="text-[10px] text-cream/60 mt-0.5 line-clamp-2" title={rp.nota}>{rp.nota}</div>}
                                <div className="text-[11px] text-cream/70 mt-1">R$ {price.toFixed(2)}</div>
                                <button
                                  className="mt-1.5 w-full border border-coral-accent/30 rounded px-1.5 py-1 text-[11px] hover:bg-coral-accent/10 disabled:opacity-50"
                                  onClick={() => handleAddRecommended(rp)}
                                  disabled={!guest}
                                >
                                  Adicionar
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })()}
        </DialogContent>
      </Dialog>

      {/* Barra fixa do carrinho quando lista é longa */}
      {tab === 'menu' && guest && cart.length > 0 && !autoJoinInProgress && !cartSectionVisible && (
        <div className="fixed bottom-0 inset-x-0 z-40 bg-forest-dark border-t border-coral-accent/20 pb-[env(safe-area-inset-bottom)]">
          <div className="max-w-md mx-auto px-3 py-2 flex items-center justify-between gap-2">
            <div className="min-w-0 text-xs sm:text-sm text-cream/90 whitespace-nowrap">
              <span className="font-medium">{cart.reduce((s, c) => s + c.quantidade, 0)} item(s)</span>
              <span className="mx-2 text-cream/50">•</span>
              <span className="font-medium">R$ {cart.reduce((sum, c) => sum + c.preco * c.quantidade, 0).toFixed(2)}</span>
            </div>
            <div className="flex items-center gap-2">
              <button
                className="h-9 sm:h-10 px-3 rounded border border-coral-accent/30 text-cream text-xs sm:text-sm hover:bg-coral-accent/10 whitespace-nowrap"
                onClick={() => setCartOpen(true)}
              >
                Ver carrinho
              </button>
              <button
                className="h-9 sm:h-10 px-4 rounded bg-coral-accent hover:bg-coral-accent/90 text-forest-dark text-xs sm:text-sm"
                onClick={sendOrder}
                disabled={loading || !guest}
              >
                Enviar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Bottom sheet com carrinho detalhado */}
      <Sheet open={cartOpen} onOpenChange={setCartOpen}>
        <SheetContent side="bottom" className="bg-forest-dark text-cream border-t border-coral-accent/20 p-0">
          <div className="max-w-md mx-auto w-full">
            <SheetHeader className="px-4 py-3 border-b border-coral-accent/20">
              <SheetTitle className="text-sm tracking-wide text-cream/80">Seu carrinho</SheetTitle>
            </SheetHeader>
            <div className="p-4">
              {cart.length === 0 ? (
                <div className="text-sm text-cream/60">Vazio</div>
              ) : (
                <div className="space-y-3">
                  {cart.map((c) => {
                    const keyId = c.skuId ?? c.produtoId;
                    return (
                      <div key={keyId} className="border border-coral-accent/20 rounded p-2 sm:p-3 bg-coral-accent/5">
                        <div className="flex justify-between items-start mb-2">
                          <div className="flex-1">
                            <div className="font-medium text-xs sm:text-sm">{c.nome}</div>
                            <div className="text-[11px] sm:text-xs text-cream/70">R$ {c.preco.toFixed(2)} cada</div>
                          </div>
                          <button onClick={() => removeFromCart(keyId)} className="text-red-400 hover:text-red-300 px-2 py-1 text-sm" title="Remover item">✕</button>
                        </div>
                        <div className="flex items-center justify-between mb-2 gap-2">
                          <div className="flex items-center gap-2">
                            <button onClick={() => decreaseQuantity(keyId)} className="border border-coral-accent/30 px-2 py-1 rounded hover:bg-coral-accent/10 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center">−</button>
                            <span className="text-xs sm:text-sm font-medium w-7 sm:w-8 text-center">{c.quantidade}</span>
                            <button onClick={() => increaseQuantity(keyId)} className="border border-coral-accent/30 px-2 py-1 rounded hover:bg-coral-accent/10 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center">+</button>
                          </div>
                          <ObservationEditor value={c.observacoes || ''} onChange={(v) => updateCartObservacoes(keyId, v)} />
                          <div className="font-medium text-sm sm:text-base whitespace-nowrap">R$ {(c.preco * c.quantidade).toFixed(2)}</div>
                        </div>
                        
                      </div>
                    );
                  })}
                  <div className="border-t border-coral-accent/20 pt-3">
                    <div className="flex justify-between font-medium mb-3 text-sm sm:text-base"><span>Total</span><span>R$ {cart.reduce((sum, c) => sum + c.preco * c.quantidade, 0).toFixed(2)}</span></div>
                    <button className="bg-coral-accent hover:bg-coral-accent/90 text-forest-dark px-4 py-2 rounded w-full" onClick={() => { setCartOpen(false); sendOrder(); }} disabled={loading || !guest}>Enviar pedido</button>
                  </div>
                </div>
              )}
            </div>
          </div>
        </SheetContent>
      </Sheet>

      {/* Menu do Usuário */}
      <Sheet open={showUserMenu} onOpenChange={setShowUserMenu}>
        <SheetContent side="right" className="bg-forest-dark border-l border-coral-accent/20">
          <SheetHeader className="pb-4 border-b border-coral-accent/20">
            {/* Header com avatar e informações */}
            <div className="flex items-center gap-3">
              {isAuthenticated && user?.fotoPerfil ? (
                <img
                  src={user.fotoPerfil}
                  alt={user.nome}
                  className="w-12 h-12 rounded-full object-cover border-2 border-coral-accent/30"
                />
              ) : (
                <div className="w-12 h-12 rounded-full bg-coral-accent/20 border-2 border-coral-accent/30 flex items-center justify-center text-lg font-medium text-cream">
                  {guest?.nomeExibicao?.[0]?.toUpperCase() || '?'}
                </div>
              )}
              <div className="text-left">
                <div className="text-cream font-medium">Olá, {guest?.nomeExibicao}</div>
                {user?.email && <div className="text-xs text-cream/70">{user.email}</div>}
              </div>
            </div>
          </SheetHeader>

          {/* Opções do Menu */}
          <div className="mt-6 space-y-2">
            {/* Ir para o Site */}
            <Button
              variant="outline"
              onClick={() => {
                setShowUserMenu(false);
                navigate('/');
              }}
              className="w-full justify-start border-coral-accent/30 text-cream hover:bg-coral-accent/10 hover:text-coral-accent hover:border-coral-accent/50"
            >
              <Home className="w-4 h-4 mr-3" />
              Ir para o Site
            </Button>

            {/* Meus Favoritos (se autenticado) */}
            {isAuthenticated && (
              <Button
                variant="outline"
                onClick={() => {
                  setShowUserMenu(false);
                  navigate('/favoritos');
                }}
                className="w-full justify-start border-coral-accent/30 text-cream hover:bg-coral-accent/10 hover:text-coral-accent hover:border-coral-accent/50"
              >
                <Star className="w-4 h-4 mr-3" />
                Meus Favoritos
              </Button>
            )}

            {/* Área do Cliente (se autenticado e CLIENTE) */}
            {isAuthenticated && user?.roles?.includes('CLIENTE') && (
              <Button
                variant="outline"
                onClick={() => {
                  setShowUserMenu(false);
                  navigate('/areacliente');
                }}
                className="w-full justify-start border-coral-accent/30 text-cream hover:bg-coral-accent/10 hover:text-coral-accent hover:border-coral-accent/50"
              >
                <User className="w-4 h-4 mr-3" />
                Área do Cliente
              </Button>
            )}

            {/* Compartilhar Mesa */}
            <Button
              variant="outline"
              onClick={() => {
                setShowUserMenu(false);
                setShowShareDialog(true);
              }}
              className="w-full justify-start border-coral-accent/30 text-cream hover:bg-coral-accent/10 hover:text-coral-accent hover:border-coral-accent/50"
            >
              <Share2 className="w-4 h-4 mr-3" />
              Compartilhar Mesa
            </Button>
          </div>
        </SheetContent>
      </Sheet>

      {/* Dialog de Compartilhar Mesa */}
      <Dialog open={showShareDialog} onOpenChange={setShowShareDialog}>
        <DialogContent className="bg-forest-dark border-coral-accent/20">
          <DialogHeader>
            <DialogTitle className="text-cream">Compartilhar Mesa {mesaSlug}</DialogTitle>
            <DialogDescription className="text-cream/70">
              Seus amigos podem escanear este QR Code para entrar na mesa
            </DialogDescription>
          </DialogHeader>

          <div className="flex flex-col items-center gap-4 py-6">
            {/* QR Code */}
            {shareQrUrl && (
              <div className="bg-white p-4 rounded-lg">
                <img
                  src={shareQrUrl}
                  alt={`QR Code Mesa ${mesaSlug}`}
                  className="w-64 h-64"
                />
              </div>
            )}

            {/* URL para compartilhar */}
            <div className="w-full">
              <p className="text-xs text-cream/70 mb-2">Ou compartilhe o link:</p>
              <div className="flex gap-2">
                <input
                  type="text"
                  value={`${window.location.origin}/m/${mesaSlug}`}
                  readOnly
                  className="flex-1 bg-forest-dark border border-coral-accent/30 rounded px-3 py-2 text-sm text-cream"
                  onClick={(e) => (e.target as HTMLInputElement).select()}
                />
                <Button
                  onClick={() => {
                    navigator.clipboard.writeText(`${window.location.origin}/m/${mesaSlug}`);
                    toast({
                      title: 'Link copiado!',
                      description: 'O link da mesa foi copiado para a área de transferência.',
                    });
                  }}
                  className="bg-coral-accent text-forest-dark hover:bg-coral-accent/90"
                >
                  Copiar
                </Button>
              </div>
            </div>

            {/* Informações adicionais */}
            <div className="text-center text-xs text-cream/70">
              <p>Qualquer pessoa com este link ou QR Code pode entrar na mesa</p>
              {guest && contaMesa && (
                <p className="mt-2">
                  Pessoas na mesa: <span className="text-coral-accent font-medium">{contaMesa.pessoas.length}</span>
                </p>
              )}
            </div>
          </div>

          <div className="flex justify-end">
            <Button
              onClick={() => setShowShareDialog(false)}
              className="bg-coral-accent text-forest-dark hover:bg-coral-accent/90"
            >
              Fechar
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      <style>{`.badge{font-weight:500}.no-scrollbar::-webkit-scrollbar{display:none}.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none}`}</style>
    </div>
  );
}
