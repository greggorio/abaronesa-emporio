# Runtime mode: publisher (default) or deployer
RELEASE_CONTROL_PROFILE=development
RELEASE_CONTROL_MODE=publisher

# Database
RELEASE_CONTROL_DB_HOST=127.0.0.1
RELEASE_CONTROL_DB_PORT=5432
RELEASE_CONTROL_DB_NAME=emporio_release_control
RELEASE_CONTROL_DB_USER=publisher_example
RELEASE_CONTROL_DB_PASSWORD=replace-with-secret
RELEASE_CONTROL_DB_SSLMODE=disable

# Publisher identity (issuer/audience paired by mode)
RELEASE_CONTROL_JWT_ISSUER=http://127.0.0.1:8080/api/release-control/identity
RELEASE_CONTROL_JWT_AUDIENCE=emporio-release-control
RELEASE_CONTROL_JWT_JWKS_URL=http://127.0.0.1:8080/api/release-control/identity/jwks

# For deployer mode, replace the above with:
# RELEASE_CONTROL_MODE=deployer
# RELEASE_CONTROL_JWT_ISSUER=http://127.0.0.1:8080/api/release-control/identity/deployer
# RELEASE_CONTROL_JWT_AUDIENCE=emporio-release-control-deployer
# RELEASE_CONTROL_JWT_JWKS_URL=http://127.0.0.1:8080/api/release-control/identity/deployer/jwks
RELEASE_CONTROL_CORS_ORIGINS=http://localhost:8084
RELEASE_CONTROL_GITHUB_APP_ID=100000
RELEASE_CONTROL_GITHUB_INSTALLATION_ID=200000
RELEASE_CONTROL_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key
RELEASE_CONTROL_HASH_PEPPER=replace-with-at-least-32-random-bytes
RELEASE_CONTROL_RECONCILE_INTERVAL_SECONDS=15
RELEASE_CONTROL_DISPATCH_DISCOVERY_TIMEOUT_SECONDS=600
RELEASE_CONTROL_HTTP_CONNECT_TIMEOUT_SECONDS=3
RELEASE_CONTROL_HTTP_READ_TIMEOUT_SECONDS=10
RELEASE_CONTROL_GITHUB_MAX_PAGES=10
RELEASE_CONTROL_IDEMPOTENCY_RETENTION_DAYS=365
RELEASE_CONTROL_READ_RATE_PER_MINUTE=120
RELEASE_CONTROL_PUBLISH_RATE_PER_MINUTE=5
RELEASE_CONTROL_DEPLOY_RATE_PER_MINUTE=5
RELEASE_CONTROL_ROLLBACK_RATE_PER_MINUTE=2
RELEASE_CONTROL_MAX_JSON_BODY_BYTES=16384
