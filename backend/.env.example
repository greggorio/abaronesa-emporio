# Exemplo de variáveis de ambiente para o backend ERP.
# Prefira copiar o exemplo da raiz para .env.local.
# NUNCA commite arquivos .env com chaves reais.

# Bootstrap administrativo opt-in
ROOT_BOOTSTRAP_ENABLED=false
ROOT_BOOTSTRAP_NAME=Root
ROOT_BOOTSTRAP_EMAIL=
ROOT_BOOTSTRAP_PASSWORD=

# ===================================================================
# API OpenAI - Necessária para geração de imagens IA
# ===================================================================
OPENAI_API_KEY=

# ===================================================================
# Banco de Dados
# ===================================================================
# DB_URL=jdbc:postgresql://localhost:5432/villa_erp_db
# DB_USERNAME=postgres
DB_PASSWORD=

# ===================================================================
# Token compartilhado com o backend do website (obrigatorio)
# ===================================================================
INTEGRATION_SYSTEM_TOKEN_SECRET=

# Ponte RS256/JWKS do publisher (opt-in; chave sempre fora do repositorio)
RELEASE_CONTROL_IDENTITY_ENABLED=false
RELEASE_CONTROL_IDENTITY_ISSUER=
RELEASE_CONTROL_IDENTITY_PRIVATE_KEY_PATH=
RELEASE_CONTROL_IDENTITY_KEY_ID=

# Ponte RS256/JWKS do deployer (opt-in; chave sempre fora do repositorio)
RELEASE_CONTROL_DEPLOYER_IDENTITY_ENABLED=false
RELEASE_CONTROL_DEPLOYER_IDENTITY_ISSUER=
RELEASE_CONTROL_DEPLOYER_IDENTITY_PRIVATE_KEY_PATH=
RELEASE_CONTROL_DEPLOYER_IDENTITY_KEY_ID=

# OAuth2 Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uber Direct (opcional)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_ACCESS_TOKEN=

# Sincronizacao com o backend do website (opcional)
ESPRESSO_SYNC_API_KEY=
