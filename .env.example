# Referencia comum para desenvolvimento local.
# Copie para .env.local e preencha somente no arquivo local ignorado.

# Bootstrap administrativo opt-in. Desabilite apos a criacao inicial.
ROOT_BOOTSTRAP_ENABLED=false
ROOT_BOOTSTRAP_NAME=Root
ROOT_BOOTSTRAP_EMAIL=
ROOT_BOOTSTRAP_PASSWORD=

# Obrigatorias para os backends
# Use exatamente o mesmo token no backend ERP e no backend do website.
INTEGRATION_SYSTEM_TOKEN_SECRET=
DB_PASSWORD=

# Opcionais: OAuth2 Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcionais: Uber Direct
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_ACCESS_TOKEN=

# Opcionais: sincronizacao entre os backends
ESPRESSO_SYNC_API_KEY=
WEBSITE_ERP_SYNC_KEY=
