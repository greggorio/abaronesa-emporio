# Exemplo de variaveis de ambiente para o backend do website.
# Prefira copiar o exemplo da raiz para .env.local.
# NUNCA commite arquivos .env com chaves reais.

# Obrigatorias
DB_PASSWORD=
INTEGRATION_SYSTEM_TOKEN_SECRET=

# Uber Direct (opcional)
UBER_CLIENT_ID=
